# WordPress site URL (no trailing slash)
VITE_WP_URL=https://www.ancillarypower.com

# Extra origins allowed by the CSP connect-src directive (Issue #583).
# Space-separated, https:// origins only, no path and no wildcard.
# The origin of VITE_WP_URL, the CORS proxies and the 3D decoder CDN paths
# are always included. Changing this requires a rebuild. See README.
# VITE_CSP_CONNECT_EXTRA=https://staging.ancillarypower.com

# WooCommerce credentials are entered via the in-app Settings panel.
# Never add API secrets with the VITE_ prefix: they get embedded in
# the client bundle and are publicly visible.  See issue #247.
